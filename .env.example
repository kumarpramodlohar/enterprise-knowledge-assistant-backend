# Copy to .env (git-ignored) and set real values.
EKA_DB_NAME=eka
EKA_DB_USER=eka_app
POSTGRES_PASSWORD=root
EKA_DB_PORT=5433
# Local profile (default)
OLLAMA_BASE_URL=http://localhost:11434
# Deployed profile only
# SPRING_PROFILES_ACTIVE=deployed
# OPENAI_API_KEY=
# Local profile development login (HTTP Basic); no default password exists
EKA_LOCAL_USER=dev
EKA_LOCAL_USER_PASSWORD=devpass123
# Keycloak sign-in: SPRING_PROFILES_ACTIVE=local,oidc (Ollama) or deployed (OpenAI)
# EKA_OIDC_ISSUER_URI=http://127.0.0.1:8180/realms/eka
