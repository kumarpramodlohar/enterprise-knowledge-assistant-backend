# Copy to .env (git-ignored) and set real values.
EKA_DB_NAME=eka
EKA_DB_USER=eka_app
POSTGRES_PASSWORD=root
EKA_DB_PORT=5433
# Local profile (default). Choose providers independently: ollama or openai.
EKA_CHAT_PROVIDER=ollama
EKA_EMBEDDING_PROVIDER=ollama
EKA_CHAT_MODEL=llama3.2:latest
EKA_EMBEDDING_MODEL=nomic-embed-text
EKA_EMBEDDING_DIMENSIONS=768
EKA_VECTOR_TABLE=vector_store_ollama
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Deployed profile only
# SPRING_PROFILES_ACTIVE=deployed
# Local-only development login (HTTP Basic). Change this password before sharing the environment.
EKA_LOCAL_USER=dev
EKA_LOCAL_USER_PASSWORD=devpass123
# Keycloak sign-in: SPRING_PROFILES_ACTIVE=local,oidc; AI providers are independently configurable above.
# For local OpenAI embeddings set EKA_EMBEDDING_PROVIDER=openai,
# EKA_EMBEDDING_MODEL=text-embedding-3-small, EKA_EMBEDDING_DIMENSIONS=1536,
# EKA_VECTOR_TABLE=vector_store_openai and provide OPENAI_API_KEY.
# For OpenAI chat set EKA_CHAT_PROVIDER=openai and EKA_CHAT_MODEL=gpt-4o-mini.
# EKA_OIDC_ISSUER_URI=http://127.0.0.1:8180/realms/eka

# Corrective RAG is opt-in. External search also needs per-question user consent.
EKA_CRAG_ENABLED=false
EKA_WEB_SEARCH_ENABLED=false
EKA_WEB_SEARCH_TIMEOUT=8s
TAVILY_API_KEY=
